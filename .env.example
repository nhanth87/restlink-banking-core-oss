# Restlink Banking Core — lab env (copy to .env; never commit real secrets).
# Names match restlink-app/src/main/resources/application.properties.

# --- Auth (REQUIRED). Blank / "change-me" is rejected; admin key must be >= 12 chars. ---
RESTLINK_ADMIN_KEY=
RESTLINK_API_KEY=

# --- Datastore ---
RESTLINK_DB_URL=jdbc:postgresql://127.0.0.1:5432/restlink
RESTLINK_DB_USER=restlink
RESTLINK_DB_PASS=

# --- Core banking provider for the default tenant: WALLET_LEDGER | FINERACT | TEMENOS ---
RESTLINK_CORE_PROVIDER=WALLET_LEDGER
# Optional per-tenant overrides, e.g. et:FINERACT,ke:WALLET_LEDGER
RESTLINK_CORE_BINDINGS=

# --- Cluster: LOCAL = single-node lab only; DIST_SYNC for N >= 2 ---
RESTLINK_CLUSTER_MODE=LOCAL

# --- Temporal (money plane; fail-closed when unreachable) ---
RESTLINK_TEMPORAL_TARGET=127.0.0.1:7233
RESTLINK_TEMPORAL_NAMESPACE=restlink
RESTLINK_TEMPORAL_FAIL_OPEN=false

# --- ra-fineract (external engine, own JDK). Registered only when the URL is set. ---
RESTLINK_FINERACT_URL=
RESTLINK_FINERACT_TENANT=default
RESTLINK_FINERACT_USER=
RESTLINK_FINERACT_PASS=
RESTLINK_FINERACT_INSECURE_TLS=false
RESTLINK_FINERACT_ALLOW_INSECURE_TLS_LAB=false

# --- ra-temenos (licensed engine, own runtime). Use https outside a lab. ---
RESTLINK_TEMENOS_URL=
RESTLINK_TEMENOS_USER=
RESTLINK_TEMENOS_PASS=
RESTLINK_TEMENOS_COMPANY=
