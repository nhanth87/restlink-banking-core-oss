<?xml version="1.0" encoding="UTF-8"?>
<!-- Restlink-core — Log4j2 only (house standard). Hot path: no full payload dumps. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{ISO8601} %-5level [%t] %c{1.} - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="et.restlink" level="INFO"/>
    <Logger name="org.infinispan" level="WARN"/>
    <Logger name="org.jgroups" level="WARN"/>
    <Root level="INFO">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
